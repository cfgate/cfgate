{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "configMigration": true,
  "extends": ["config:recommended"],
  "schedule": ["before 9am on monday"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["**/deployment.go"],
      "matchStrings": [
        "DefaultImage\\s*=\\s*\"(?<depName>[^:]+):(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["**/Dockerfile"],
      "matchStrings": [
        "FROM\\s+(?:--platform=\\S+\\s+)?(?<depName>[^:\\s]+):(?<currentValue>[^\\s]+)"
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "Group Kubernetes client libraries",
      "matchPackageNames": ["/^k8s\\.io\\//"],
      "groupName": "kubernetes"
    },
    {
      "description": "Group controller-runtime and gateway-api",
      "matchPackageNames": ["/^sigs\\.k8s\\.io\\//"],
      "groupName": "kubernetes-sigs"
    },
    {
      "description": "Group Ginkgo and Gomega",
      "matchPackageNames": ["/^github\\.com\\/onsi\\//"],
      "groupName": "ginkgo"
    },
    {
      "description": "Auto-merge patch updates for indirect deps",
      "matchDepTypes": ["indirect"],
      "matchUpdateTypes": ["patch"],
      "automerge": true
    },
    {
      "description": "Cloudflared fork image; manual review",
      "matchPackageNames": ["ghcr.io/inherent-design/cloudflared"],
      "enabled": false
    }
  ]
}
