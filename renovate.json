{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "configMigration": true,
  "extends": ["config:recommended"],
  "schedule": ["before 9am on monday"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["**/deployment.go"],
      "matchStrings": ["DefaultImage\\s*=\\s*\"(?<depName>[^:]+):(?<currentValue>[^\"]+)\""],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/.github/workflows/.*\\.yml$/"],
      "matchStrings": ["version: (?<currentValue>v[0-9.]+) # renovate: depName=(?<depName>[^\\s]+)"],
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^test/e2e/e2e_suite_test\\.go$/",
        "/^mise\\.toml$/"
      ],
      "matchStrings": [
        "gateway-api/releases/download/(?<currentValue>v\\d+\\.\\d+\\.\\d+)/",
        "GATEWAY_API_VERSION:-(?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "kubernetes-sigs/gateway-api",
      "datasourceTemplate": "github-releases"
    }
  ],
  "packageRules": [
    {
      "description": "Group Kubernetes client libraries",
      "matchPackageNames": ["/^k8s\\.io\\//"],
      "groupName": "kubernetes"
    },
    {
      "description": "Group controller-runtime and gateway-api",
      "matchPackageNames": ["/^sigs\\.k8s\\.io\\//"],
      "groupName": "kubernetes-sigs"
    },
    {
      "description": "Group Ginkgo and Gomega",
      "matchPackageNames": ["/^github\\.com\\/onsi\\//"],
      "groupName": "ginkgo"
    },
    {
      "description": "Auto-merge patch updates for indirect deps",
      "matchDepTypes": ["indirect"],
      "matchUpdateTypes": ["patch"],
      "automerge": true
    },
    {
      "description": "Cloudflared fork image; manual review",
      "matchPackageNames": ["ghcr.io/inherent-design/cloudflared"],
      "enabled": false
    },
    {
      "description": "Keep Gateway API module and install bundle aligned",
      "matchPackageNames": [
        "sigs.k8s.io/gateway-api",
        "kubernetes-sigs/gateway-api"
      ],
      "groupName": "gateway-api"
    }
  ]
}
